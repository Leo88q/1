+{
+  "name": "@guttercaps/ampergrad",
+  "version": "0.1.0",
+  "private": true,
+  "type": "module",
+  "description": "Механизм «Амперград»: фрагменты магистрали, повороты и проверка пломбы квартала. Без кошелька, без токена, без влияния на экономику GUTTERCAPS.",
+  "main": "src/index.ts",
+  "types": "src/index.ts",
+  "exports": {
+    ".": "./src/index.ts"
+  },
+  "scripts": {
+    "test": "node --experimental-strip-types --test test/*.test.ts",
+    "check": "node --experimental-strip-types --test test/*.test.ts"
+  }
+}
diff --git a/packages/ampergrad/src/index.ts b/packages/ampergrad/src/index.ts
new file mode 100644
index 0000000..dc972b1
--- /dev/null
+++ b/packages/ampergrad/src/index.ts
@@ -0,0 +1,12 @@
+/**
+ * Точка входа модуля «Амперград» для монорепо GUTTERCAPS.
+ *
+ * Экспортирует только правила и работу с фрагментами магистрали — всё, что нужно,
+ * чтобы показать квартал и проверить решение. Никаких кошельков, транзакций и
+ * обращения к экономике GUTTERCAPS здесь нет и не должно быть.
+ */
+export * from './tiles.ts';
+export * from './rules.ts';
+
+/** Версия правил. Меняется вместе с контентом кварталов: старые записи перестают совпадать. */
+export const ENGINE_VERSION = '0.1.0';
