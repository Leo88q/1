{
  "name": "ampergrad",
  "private": true,
  "version": "0.1.0",
  "description": "АМПЕРГРАД / AMPERGRAD — головоломка на соединение цепей для Solana Mobile",
  "workspaces": [
    "packages/engine",
    "packages/lab",
    "server"
  ],
  "scripts": {
    "dev": "npm --workspace @ampergrad/lab run dev",
    "build": "npm --workspace @ampergrad/lab run build",
    "test": "npm --workspace @ampergrad/engine run test && npm --workspace @ampergrad/server run test",
    "typecheck": "tsc -p packages/engine --noEmit && tsc -p packages/lab --noEmit && tsc -p server --noEmit",
    "vectors": "npm --workspace @ampergrad/engine run vectors",
    "server": "npm --workspace @ampergrad/server run start",
    "server:dev": "npm --workspace @ampergrad/server run dev",
    "content": "npm run content -w @ampergrad/engine",
    "store:data": "npm run store:data -w @ampergrad/engine",
    "store:assets": "python3 store/render_assets.py"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@metaplex-foundation/umi": "1.6.0"
  }
}
