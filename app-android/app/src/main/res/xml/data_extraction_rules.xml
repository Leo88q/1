<?xml version="1.0" encoding="utf-8"?>
<!--
  Резервное копирование выключено полностью: в локальном хранилище лежит
  MWA authToken — он не должен уезжать в бэкапы и на другое устройство.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
